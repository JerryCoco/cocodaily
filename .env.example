# Copy to .env and fill in.

# Neon (or any Postgres) — pooled connection string, used by the app at runtime.
# Neon dashboard -> Connection Details -> "Pooled connection". Append pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct (unpooled) connection — used only by `prisma migrate` and introspection.
# Same string without the "-pooler" segment in the host, and without pgbouncer=true.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Public site origin (canonical URLs, RSS, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary — image storage + on-the-fly transforms.
# Dashboard home -> "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="replace-me"
# Cloud name again, exposed to the browser so it can build image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Shared secret for the scheduled-publish cron (/api/cron/publish).
# Set the same value in Vercel project env; Vercel Cron sends it as a Bearer token.
# Leave unset in local dev to call the endpoint without auth.
CRON_SECRET=""
