# Copy to .env and fill in.

# Neon (or any Postgres) connection string.
# Neon dashboard -> Connection Details -> copy the "Prisma" / pooled string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js. Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Public site origin (used for canonical URLs, RSS, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
